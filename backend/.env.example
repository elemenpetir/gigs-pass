PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/gigspass
# Test DB terpisah (Neon branch / Supabase project kedua) untuk integration test
DATABASE_URL_TEST=postgresql://user:password@host/db?sslmode=require
# Aktifkan SSL untuk DB remote (Supabase/Neon) saat NODE_ENV bukan production
DATABASE_SSL=true
HOST_DB=your_db_host
PORT_DB=your_db_port
DATABASE=your_db_name
USER_DB=your_db_user
# Redis: pilih SATU yang aktif, sisanya komentar.
# - Dev/test/stress lokal (tanpa kuota — WAJIB untuk load test, lihat docs/deployment.md §5a):
REDIS_URL=redis://localhost:6379
# - Prod Upstash (limit 500K commands/bulan — JANGAN untuk stress test):
# REDIS_URL=rediss://...upstash...
# - Prod Redis Cloud free (tanpa hitung command, throttle 100 ops/detik):
# REDIS_URL=rediss://...rediscloud...
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Rate limiting (default titik emas ada di src/config/constants.js)
# TRUST_PROXY wajib true saat berjalan di belakang Nginx/Cloudflare
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_JOIN_MAX=30
RATE_LIMIT_GLOBAL_MAX=600
